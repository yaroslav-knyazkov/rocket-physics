__pycache__/
*.pyc
.pytest_cache/

# setuptools editable-install build artifact (e.g. from an external
# consumer's `pip install -e`, such as fx27/simulation)
*.egg-info/

# Root-level docs/ -- local LaTeX build junk (pdflatex/latexmk output
# directory when compiled outside dev/docs/latex/'s own tree), never
# committed. NOT dev/docs/ (the real documentation tree) -- deleted and
# ignored here, Step 128, Phase 2.19.
/docs/

# Root-level data/ -- the user's own personal data (real motor curves,
# real soundings, etc.), never committed. NOT examples/data/ (the bundled
# fixture corpus the test suite and example scenarios read) -- split out
# here, Step 129, Phase 2.19. The one tracked exception (`README.md`)
# gives a fresh clone the bare directory with no personal data inside it.
# NOTE: `/data/*` (not `/data/`) -- git never looks inside a fully
# ignored directory to apply a `!`-negation to one of its files, so
# ignoring the directory itself would silently swallow the negation
# below too.
/data/*
!/data/README.md

# LaTeX build artifacts (local compile of dev/docs/latex/main.tex)
dev/docs/latex/*.aux
dev/docs/latex/*.fdb_latexmk
dev/docs/latex/*.fls
dev/docs/latex/*.log
dev/docs/latex/*.out
dev/docs/latex/*.pdf
dev/docs/latex/*.synctex.gz
dev/docs/latex/*.toc

# Generated output — not source, regenerated by running run.py
output/

# --- agents kit (Claude Code) ---
.claude/wt-active.json
.claude/wt.config.local.json
.claude/settings.local.json
.claude/hooks/telegram.local.json
.claude/**/__pycache__/
.wt-slot.json
.worktrees/
graphify-out/
temporary/
dev/.status-backup/
dev/.docs-backup/
