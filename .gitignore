__pycache__/
*.pyc
.pytest_cache/

# setuptools editable-install build artifact (e.g. from an external
# consumer's `pip install -e`, such as fx27/simulation)
*.egg-info/

# Root-level docs/ -- local LaTeX build junk (pdflatex/latexmk output
# directory when compiled outside dev/docs/latex/'s own tree), never
# committed. NOT dev/docs/ (the real documentation tree) -- deleted and
# ignored here, Step 128, Phase 2.19.
/docs/

# LaTeX build artifacts (local compile of dev/docs/latex/main.tex)
dev/docs/latex/*.aux
dev/docs/latex/*.fdb_latexmk
dev/docs/latex/*.fls
dev/docs/latex/*.log
dev/docs/latex/*.out
dev/docs/latex/*.pdf
dev/docs/latex/*.synctex.gz
dev/docs/latex/*.toc

# Generated output — not source, regenerated by running run.py
output/

# Scratch / drafts (e.g. one-off MATLAB prototypes) — not project source,
# never read by agents unless the user points at a specific file inside it.
temp/

# --- agents kit (Claude Code) ---
.claude/wt-active.json
.claude/wt.config.local.json
.claude/settings.local.json
.claude/hooks/telegram.local.json
.claude/**/__pycache__/
.wt-slot.json
.worktrees/
graphify-out/
temporary/
dev/.status-backup/
dev/.docs-backup/
